generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Route {
  id          String   @id @default(uuid())
  code        String   @unique
  origin      String
  destination String
  createdAt   DateTime @default(now())

  @@unique([origin, destination])
}

model Preset {
  id        String   @id @default(uuid())
  name      String   @unique
  payload   Json
  createdAt DateTime @default(now())
}

model DisplayState {
  id        String   @id @default("CURRENT_STATE")
  payload   Json
  updatedAt DateTime @updatedAt
}
